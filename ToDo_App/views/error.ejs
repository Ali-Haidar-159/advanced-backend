<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f8f5" />
    <title>Error <%= statusCode %> | Daymark</title>
    <link rel="stylesheet" href="/css/error.css" />
  </head>
  <body>
    <main class="error-page">
      <a class="brand" href="/" aria-label="Daymark home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path
              d="M8 16.5 13.2 22 24 10"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span>daymark</span>
      </a>

      <section class="error-card" aria-labelledby="error-title">
        <div class="error-art" aria-hidden="true">
          <span class="art-orbit art-orbit--outer"></span>
          <span class="art-orbit art-orbit--inner"></span>
          <span class="art-dot art-dot--one"></span>
          <span class="art-dot art-dot--two"></span>
          <span class="art-dot art-dot--three"></span>
          <span class="art-code"><%= statusCode %></span>
          <span class="art-sparkle">✳</span>
        </div>

        <p class="eyebrow">A LITTLE DETOUR</p>
        <h1 id="error-title">We couldn't complete that.</h1>
        <p class="error-message"><%= errorMessage %></p>

        <a class="home-button" href="/">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="m8 4-6 6 6 6M2.5 10H11a6 6 0 0 1 6 6"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Back to home</span>
        </a>
        <p class="error-reference">Error code <strong><%= statusCode %></strong></p>
      </section>

      <p class="page-note">Take a breath. Your day is still yours.</p>
    </main>
  </body>
</html>
