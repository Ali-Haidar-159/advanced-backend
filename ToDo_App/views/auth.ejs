<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Sign in or create an account to organize your day with Daymark."
    />
    <title>Welcome to Daymark</title>
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <% if (locals.toast && (locals.toast.type === "success" || locals.toast.type === "error") && typeof locals.toast.message === "string" && locals.toast.message.trim()) { %>
    <div
      class="toast toast--<%= locals.toast.type %>"
      role="<%= locals.toast.type === 'error' ? 'alert' : 'status' %>"
      aria-live="<%= locals.toast.type === 'error' ? 'assertive' : 'polite' %>"
      data-toast
    >
      <span class="toast-icon" aria-hidden="true">
        <% if (locals.toast.type === "success") { %>
        <svg viewBox="0 0 20 20" fill="none">
          <path
            d="m4.5 10.2 3.4 3.3 7.6-7.7"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <% } else { %>
        <svg viewBox="0 0 20 20" fill="none">
          <path
            d="M10 6v4m0 3h.01M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <% } %>
      </span>
      <p class="toast-message"><%= locals.toast.message %></p>
      <button class="toast-close" type="button" aria-label="Dismiss notification" data-toast-close>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="m6 6 8 8m0-8-8 8"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
    <% } %>
    <main class="auth-layout">
      <section class="intro-panel" aria-label="About Daymark">
        <a class="brand" href="/" aria-label="Daymark home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path
                d="M8 16.5 13.2 22 24 10"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span>daymark</span>
        </a>

        <div class="intro-copy">
          <p class="eyebrow">A little more focus, every day</p>
          <h1>Make room for what matters.</h1>
          <p class="intro-description">
            A calmer way to collect your tasks, find your focus, and make
            meaningful progress.
          </p>
        </div>

        <div class="preview-card" aria-hidden="true">
          <div class="preview-heading">
            <div>
              <p class="preview-kicker">YOUR DAY, IN VIEW</p>
              <h2>Today</h2>
            </div>
            <span class="date-pill">3 things</span>
          </div>
          <div class="preview-task">
            <span class="task-check task-check--done">
              <svg viewBox="0 0 16 16" fill="none">
                <path
                  d="m3.5 8.2 3 3 6-6.4"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="task-copy task-copy--done">Plan the week ahead</span>
            <span class="task-time">9:00</span>
          </div>
          <div class="preview-task">
            <span class="task-check"></span>
            <span class="task-copy">Finish the important thing</span>
            <span class="task-time">11:30</span>
          </div>
          <div class="preview-task">
            <span class="task-check"></span>
            <span class="task-copy">Take a proper lunch break</span>
            <span class="task-time">12:30</span>
          </div>
          <div class="preview-footer">
            <span class="progress-track"><span></span></span>
            <span>1 of 3 complete</span>
          </div>
        </div>

        <p class="intro-note">
          <span class="note-sparkle" aria-hidden="true">✳</span>
          Small steps still move you forward.
        </p>
      </section>

      <section class="form-panel" aria-label="Account access">
        <div class="mobile-brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path
                d="M8 16.5 13.2 22 24 10"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span>daymark</span>
        </div>

        <div class="auth-card">
          <div class="form-heading">
            <p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
            <h2 id="form-title">Welcome back</h2>
            <p id="form-description">Sign in to pick up where you left off.</p>
          </div>

          <div class="auth-tabs" role="tablist" aria-label="Choose an account action">
            <button
              class="auth-tab is-active"
              id="login-tab"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="login-panel"
              data-auth-tab="login"
            >
              Log in
            </button>
            <button
              class="auth-tab"
              id="signup-tab"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="signup-panel"
              data-auth-tab="signup"
              tabindex="-1"
            >
              Sign up
            </button>
          </div>

          <form
            class="auth-form"
            id="login-panel"
            role="tabpanel"
            aria-labelledby="login-tab"
            action="/auth/login"
            method="post"
            data-auth-panel="login"
          >
            <div class="field">
              <label for="login-email">Email address</label>
              <input
                id="login-email"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />
            </div>
            <div class="field">
              <div class="label-row">
                <label for="login-password">Password</label>
                <a class="text-link" href="#forgot-password">Forgot password?</a>
              </div>
              <div class="password-input">
                <input
                  id="login-password"
                  name="password"
                  type="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
                <button
                  class="password-toggle"
                  type="button"
                  aria-label="Show password"
                  aria-pressed="false"
                  data-password-toggle="login-password"
                >
                  Show
                </button>
              </div>
            </div>
            <label class="remember-option">
              <input type="checkbox" name="remember" />
              <span class="custom-checkbox" aria-hidden="true"></span>
              <span>Keep me signed in</span>
            </label>
            <button class="submit-button" type="submit">
              <span>Log in</span>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M4.2 10h11.6m-4.8-4.8 4.8 4.8-4.8 4.8"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <p class="form-switch">
              New to Daymark?
              <button type="button" class="inline-button" data-switch-auth="signup">
                Create an account
              </button>
            </p>
          </form>

          <form
            class="auth-form"
            id="signup-panel"
            role="tabpanel"
            aria-labelledby="signup-tab"
            action="/users/signup"
            method="post"
            data-auth-panel="signup"
            hidden
          >
            <div class="field">
              <label for="signup-name">Your name</label>
              <input
                id="signup-name"
                name="name"
                type="text"
                placeholder="How should we call you?"
                autocomplete="name"
                required
              />
            </div>
            <div class="field">
              <label for="signup-email">Email address</label>
              <input
                id="signup-email"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />
            </div>
            <div class="field">
              <label for="signup-password">Create a password</label>
              <div class="password-input">
                <input
                  id="signup-password"
                  name="password"
                  type="password"
                  placeholder="At least 8 characters"
                  autocomplete="new-password"
                  required
                />
                <button
                  class="password-toggle"
                  type="button"
                  aria-label="Show password"
                  aria-pressed="false"
                  data-password-toggle="signup-password"
                >
                  Show
                </button>
              </div>
            </div>
            <button class="submit-button" type="submit">
              <span>Create account</span>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M4.2 10h11.6m-4.8-4.8 4.8 4.8-4.8 4.8"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <p class="form-switch">
              Already have an account?
              <button type="button" class="inline-button" data-switch-auth="login">
                Log in
              </button>
            </p>
          </form>

          <p class="terms-copy">
            By continuing, you agree to our
            <a class="text-link" href="#terms">Terms</a> and
            <a class="text-link" href="#privacy">Privacy Policy</a>.
          </p>
        </div>

        <p class="copyright">© <span id="current-year"></span> Daymark. Make today count.</p>
      </section>
    </main>
    <script src="/js/auth.js" defer></script>
  </body>
</html>
