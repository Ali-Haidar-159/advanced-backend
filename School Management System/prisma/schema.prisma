generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  std_id String
  name     String
  email    String @unique
  password String
  department String
  cgpa String?
  role Role @default(STUDENT) 
}